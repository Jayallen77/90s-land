{
  "name": "90s-land-playable-museum",
  "private": true,
  "type": "module",
  "scripts": {
    "author": "python3 tools/optimize_assets.py && python3 tools/render_site.py && python3 tools/process_media.py",
    "author:check": "python3 tools/optimize_assets.py --check && python3 tools/render_site.py --check && python3 tools/process_media.py --check",
    "content:extract": "python3 tools/migrate_content.py",
    "content:check": "python3 tools/migrate_content.py --check && python3 tools/validate_content.py && python3 tools/report_coverage.py --check",
    "content:baseline": "python3 tools/validate_content.py --baseline-unchanged",
    "content:report": "python3 tools/report_coverage.py",
    "content:visual-check": "node tools/capture_baseline.mjs --check",
    "test:content": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "audit": "python3 tools/audit_site.py",
    "test": "playwright test",
    "test:qa": "playwright test tests/site.spec.mjs",
    "screenshots": "node tools/capture_screenshots.mjs",
    "social-card": "python3 tools/build_social_card.py",
    "lighthouse": "node tools/run_lighthouse.mjs",
    "test:dates": "node --test tests/date-utils.test.mjs",
    "release:build": "python3 -B tools/build_release.py",
    "release:preview": "python3 -B tools/serve_release.py",
    "editorial:check": "python3 tools/check_editorial.py --check",
    "screenshots:final": "node tools/capture_phase5.mjs",
    "build": "python3 -B tools/build_release.py",
    "build:check": "python3 -B tools/build_release.py --check",
    "release:publish": "python3 -B tools/deploy_release.py",
    "release:audit": "python3 -B tools/check_release_http.py",
    "screenshots:redesign": "node tools/capture_redesign.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "sharp": "0.35.3"
  },
  "packageManager": "pnpm@11.9.0"
}
